# Variables de entorno de Vite.
# Copia este archivo como .env.local y completa los valores reales.
# Solo las variables con prefijo VITE_ quedan expuestas al navegador.

# --- Supabase (aún no implementado) ---
# La capa de datos actual es un mock local y no necesita estas variables.
# Se usarán cuando exista el servicio SupabaseFinanzasService.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anonima
